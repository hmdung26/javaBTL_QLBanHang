POSTGRES_DB=sales_management
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=change_this_strong_password

GEMINI_API_KEY=
JWT_SECRET=change_this_to_a_very_long_random_secret_key_at_least_32_chars
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com
JPA_SHOW_SQL=false

# 80 khi chạy trực tiếp với Cloudflare/Nginx ngoài. Đổi 8088 nếu port 80 đang bận.
WEB_PORT=80
